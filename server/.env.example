NODE_ENV=development

PORT=5000

MONGODB_URI=mongodb://localhost:27017/aixchange

ACCESS_TOKEN_SECRET=YOUR_ACCESS_TOKEN_SECRET_KEY

REFRESH_TOKEN_SECRET=YOUR_REFRESH_TOKEN_SECRET_KEY

ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_EXPIRY=7d

CLIENT_URL=http://localhost:5173

API_PREFIX=/api/v1

# Blockchain
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
BLOCKCHAIN_CHAIN_ID=11155111

# AIX Token
AIX_TOKEN_ADDRESS=0xYOUR_DEPLOYED_AIX_TOKEN_ADDRESS

# Treasury
TREASURY_ADDRESS=0xYOUR_DEPLOYED_TREASURY_ADDRESS

# Purchase Engine (required for POST /api/v1/token/purchase and purchase event indexing)
PURCHASE_ENGINE_ADDRESS=0xYOUR_DEPLOYED_PURCHASE_ENGINE_ADDRESS

# Dataset marketplace (Phase 4)
DATASET_REGISTRY_ADDRESS=0xYOUR_DEPLOYED_DATASET_REGISTRY_ADDRESS
LICENSE_REGISTRY_ADDRESS=0xYOUR_DEPLOYED_LICENSE_REGISTRY_ADDRESS
# 32-byte AES-256-GCM key encoded as base64 (generate with: openssl rand -base64 32)
DATASET_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY
PINATA_JWT=YOUR_PINATA_JWT
# Optional, defaults to Pinata's pinFileToIPFS endpoint
PINATA_API_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
DATASET_MAX_UPLOAD_BYTES=52428800

# Optional
BLOCKCHAIN_CONFIRMATIONS=1
BLOCKCHAIN_START_BLOCK=0
INDEXER_INTERVAL_MS=15000
INDEXER_BATCH_SIZE=1000
